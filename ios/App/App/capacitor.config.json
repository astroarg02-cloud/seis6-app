{
	"appId": "com.seis6.app",
	"appName": "Seis6 App",
	"webDir": "dist",
	"backgroundColor": "#000000",
	"android": {
		"backgroundColor": "#000000",
		"allowMixedContent": true,
		"captureInput": true,
		"webContentsDebuggingEnabled": false
	},
	"ios": {
		"backgroundColor": "#000000",
		"allowsLinkPreview": false,
		"scrollEnabled": false,
		"contentInset": "never",
		"preferredContentMode": "mobile"
	},
	"server": {
		"cleartext": true,
		"androidScheme": "https"
	},
	"plugins": {
		"StatusBar": {
			"overlaysWebView": true,
			"style": "DARK",
			"backgroundColor": "#000000"
		}
	},
	"packageClassList": []
}
